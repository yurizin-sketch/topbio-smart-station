node_modules/
dist/

# Mockups de origem: são ficheiros de 10 MB cada e não fazem falta para
# arrancar a estação — o que conta são os .webp já gerados em
# public/products, esses sim versionados. Regenerar com
# `node scripts/build-product-images.mjs` a partir de uma destas pastas.
Product/

# Configuração local do Claude Code (aponta para um proxy na máquina).
.claude/

# Configuração da máquina, incluindo `.env.local`. Este repositório é público:
# nada que aponte para uma chave pode entrar nele.
*.local
.env
.env.*
!.env.example

# Segredos do `wrangler dev`: palavras-passe e chaves de assinatura para
# experimentar na própria máquina. Em produção isto vive em
# `wrangler secret put`, que nunca toca no disco do repositório. Este ficheiro
# não pode entrar aqui em circunstância nenhuma — o repositório é público.
.dev.vars
.dev.vars.*

# Estado local do wrangler: cache, ficheiros temporários do `wrangler dev` e a
# simulação do KV. Nada disto serve a outra máquina.
.wrangler/

.DS_Store
Thumbs.db
